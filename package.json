{
  "name": "operbots-mcp",
  "version": "0.1.0",
  "description": "MCP-сервер панели operbots: дела, боты, сценарии, диалоги и база знаний из Claude Code",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "claude-code",
    "operbots",
    "telegram"
  ],
  "license": "MIT",
  "author": "Nikita Belan",
  "homepage": "https://github.com/uk-kd/operbots-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uk-kd/operbots-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/uk-kd/operbots-mcp/issues"
  },
  "//": "mcpName подтверждает владение пакетом при публикации в реестре MCP.",
  "mcpName": "io.github.uk-kd/operbots-mcp",
  "type": "module",
  "bin": {
    "operbots-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -w -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/index.js",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.9.0"
  }
}

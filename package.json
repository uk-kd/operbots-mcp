{
  "name": "operbots-mcp",
  "version": "0.1.18",
  "description": "MCP-сервер всех разделов панели operbots для Codex, Claude Code и других MCP-клиентов",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "claude-code",
    "operbots",
    "telegram",
    "max"
  ],
  "license": "MIT",
  "author": "Nikita Belan",
  "homepage": "https://github.com/uk-kd/operbots-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uk-kd/operbots-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/uk-kd/operbots-mcp/issues"
  },
  "type": "module",
  "bin": {
    "operbots-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/pack-plugin.mjs",
    "watch": "tsc -w -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test && node scripts/plugin-smoke.mjs",
    "test:backend": "node scripts/backend-smoke.mjs",
    "start": "node dist/index.js",
    "prepare": "npm run build",
    "version": "node scripts/sync-version.mjs && npm run build && git add plugins"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0"
  }
}
